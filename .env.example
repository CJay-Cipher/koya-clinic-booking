# Copy this file to .env for local development with `vercel dev`,
# and set the same two values as Environment Variables in your Vercel
# project settings for the deployed app.

# Postgres connection string from Neon (or Supabase, or any Postgres).
# Neon's free tier gives you this directly when you create a project --
# use the "pooled connection" string it offers, it already includes
# ?sslmode=require.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Any long random string. Callers must send this exact value in the
# X-API-Key header on every request.
API_KEY=choose-a-long-random-string-here

# Used only by the frontend build (Vite inlines this into the built JS --
# see the README's "About the API key" section for why that's an expected
# trade-off here, not an oversight). Must match API_KEY above.
VITE_API_KEY=choose-a-long-random-string-here
